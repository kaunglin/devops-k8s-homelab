# Copy to .env and fill in. .env is gitignored and must never be committed.
#
#   cp .env.example .env
#
# Keeps one Argo CD admin password across reinstalls instead of a new random
# one each time. The script bcrypt-hashes it with htpasswd and passes only the
# hash to Helm, so the plaintext never leaves this file.
#
# Leave unset to keep ArgoCD's default behaviour (random password, readable
# from the argocd-initial-admin-secret Secret).
ARGOCD_ADMIN_PASSWORD=

# Address other machines/VMs use to reach the kube API server.
# Defaults to <cluster>-control-plane.orb.local for OrbStack.
#API_SERVER_HOST=

# Worker node count (default 2). Drop to 1 for memory-heavy stacks.
#WORKER_COUNT=1
